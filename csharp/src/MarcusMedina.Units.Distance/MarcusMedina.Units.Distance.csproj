<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageId>MarcusMedina.Units.Distance</PackageId>
    <Version>1.0.2</Version>
    <Title>MarcusMedina.Units.Distance</Title>
    <Description>Fluent distance unit conversion — modern, Swedish, English, and American customary units.</Description>
    <Authors>Marcus Medina</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/MarcusMedinaPro/MarcusMedina.Units.Distance/wiki</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarcusMedinaPro/MarcusMedina.Units.Distance</RepositoryUrl>
    <PackageTags>distance;units;conversion;fluent;metric;imperial;swedish</PackageTags>
    <NoWarn>CS1573;CS1591</NoWarn>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>MarcusMedina.Units.Distance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\open-source.svg" Pack="true" PackagePath="assets\" />
  </ItemGroup>
</Project>
